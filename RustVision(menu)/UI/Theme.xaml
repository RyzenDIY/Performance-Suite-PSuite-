<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= COLOR PALETTE ================= -->
    <Color x:Key="ColorBackground">#FF080909</Color>
    <Color x:Key="ColorPanel">#FF0D0F0F</Color>
    <Color x:Key="ColorPanelAlt">#FF111313</Color>
    <Color x:Key="ColorAccent">#FFE51E24</Color>
    <Color x:Key="ColorAccentDark">#FF351313</Color>
    <Color x:Key="ColorText">#FFEEEEEE</Color>
    <Color x:Key="ColorTextSecondary">#FF999999</Color>
    <Color x:Key="ColorMuted">#FF666666</Color>
    <Color x:Key="ColorSuccess">#FF50D72F</Color>
    <Color x:Key="ColorBorder">#FF1E2020</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushPanelAlt" Color="{StaticResource ColorPanelAlt}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentDark" Color="{StaticResource ColorAccentDark}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />

    <!-- ================= TYPOGRAPHY ================= -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

    <Style x:Key="TextSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

    <Style x:Key="TextMuted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
    </Style>

    <!-- ================= WINDOW BASE ================= -->
    <Style x:Key="RootBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ================= SCROLLBAR ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
    </Style>

</ResourceDictionary>
